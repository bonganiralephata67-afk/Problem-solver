# Supabase Configuration
# Replace these with your project values from the Supabase Dashboard (Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Demo Mode override ('true' or 'false')
# If credentials are not set, demo mode is enabled automatically with full interactive features.
VITE_DEMO_MODE=false
